# Azure PO Classifier API
AZURE_CLASSIFY_URL=https://your-function-app.azurewebsites.net/api/classify-po
AZURE_FUNCTION_KEY=

# Batching
BATCH_SIZE=5

# Max PO data rows per Excel (header row is not counted)
MAX_EXCEL_PO_ROWS=50

# Timeouts / retries for Azure calls
AZURE_TIMEOUT_SECONDS=300
AZURE_MAX_RETRIES=3
AZURE_RETRY_BACKOFF_SECONDS=2

# Excel column headers (exact names)
EXCEL_PO_COLUMN=Purchase Order Number
EXCEL_JSON_COLUMN=ERP JSON

# Hardcoded ERP overrides applied before processing / download
OVERRIDE_LOCATIONCODE=2701163
OVERRIDE_COMPANYNAME=Myntra Designs Private Limited
OVERRIDE_COMPANYCODE=502
# Fallback customerid for Azure classify-po / Pinecone when ERP JSON lacks a usable one.
# Prefer ERP customerid when present and numeric (non-zero). Leave empty to omit when missing.
OVERRIDE_CUSTOMERID=1063

# Where job files are stored (relative to backend folder or absolute)
JOBS_DIR=jobs

# CORS — comma-separated frontend origins
# Local: http://localhost:5173
# Production: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server
HOST=0.0.0.0
PORT=8000

# --- Auth (required) ---
# Format: username:bcrypt_hash  (comma-separated for multiple users)
# Generate hash: python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
# Leave empty until you create a hash — API stays locked (503 on login).
APP_USERS=

# Random secret used to sign session cookies (required). Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-string

SESSION_COOKIE_NAME=po_ui_session
# Session lifetime in hours (change anytime without code edits)
SESSION_MAX_AGE_HOURS=8

# Local (Vite + API on localhost): COOKIE_SAMESITE=lax, COOKIE_SECURE=false
# Production with Vercel /api proxy → Render: COOKIE_SAMESITE=lax, COOKIE_SECURE=true
# Browser calling Render directly (no proxy): COOKIE_SAMESITE=none, COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
